read_verilog -sv gpu/rtl/gpu_top.v gpu/rtl/mem_ctrl.v gpu/rtl/framebuffer.v gpu/rtl/shader_core.v gpu/rtl/gpu_alu.v gpu/rtl/gpu_reg_file.v gpu/rtl/gpu_prog_counter.v
chparam -set N_CORES 2 -set START_HALTED 1 -set HAS_FB 1 gpu_top
synth_xilinx -top gpu_top -family xc7 -flatten -run :map_luts
opt_expr -mux_undef -noclkinv
abc -luts 2:2,3,6:5,10,20
clean
techmap -map +/xilinx/lut_map.v -map +/xilinx/cells_map.v -D LUT_WIDTH=6
xilinx_dffopt
opt_lut_ins -tech xilinx
synth_xilinx -top gpu_top -family xc7 -run finalize:
tee -o fpga/util_2.txt stat
